# Development env — loaded by `npm run dev` and the e2e build (mode=development).
# Points the app at the LOCAL Firebase emulators. Safe to commit: no real
# project, no secrets. Start the emulators with:
#   npx firebase emulators:start --only auth,firestore
# The project id MUST match the emulator's default project (.firebaserc).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=listahan-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=listahan-dev
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATOR=true
