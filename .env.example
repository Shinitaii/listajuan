# Template for .env.production (real Firebase web config). Copy to .env.production
# and fill in your project's values from the Firebase console:
#   cp .env.example .env.production
#
# For LOCAL development you do NOT need this file — `.env.development` (committed,
# emulator config) is used by `npm run dev`. Enable Anonymous sign-in in the
# Firebase console (Auth -> Sign-in method) for the production project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Must be false in production; the emulator config lives in .env.development.
VITE_USE_EMULATOR=false
