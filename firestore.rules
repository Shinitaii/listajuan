rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isMember(listId) {
      return get(/databases/$(database)/documents/lists/$(listId))
               .data.members[request.auth.uid] != null;
    }

    function isOwner(listId) {
      return get(/databases/$(database)/documents/lists/$(listId))
               .data.ownerId == request.auth.uid;
    }

    // Returns true when the incoming pendingJoinToken references a valid,
    // non-expired invite for this list. Used only on the join-write path.
    function validToken(token, listId) {
      let inv = get(/databases/$(database)/documents/invites/$(token));
      return inv.data.listId == listId
          && inv.data.expiresAt > request.time.toMillis();
    }

    // ── Household list doc ────────────────────────────────────────────────────

    match /lists/{listId} {
      allow read: if request.auth != null && isMember(listId);

      // Create: caller becomes owner and is in members map.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members[request.auth.uid] != null;

      // Normal member update (e.g. trip name, other non-members-map fields).
      allow update: if request.auth != null && isMember(listId)
                    && !('pendingJoinToken' in request.resource.data)
                    && request.resource.data.members == resource.data.members;

      // Owner removes a member: only the members map changes, owner stays.
      allow update: if request.auth != null && isOwner(listId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && !('pendingJoinToken' in request.resource.data);

      // Member leaves: only their own uid is removed from members.
      allow update: if request.auth != null && isMember(listId)
                    && !(request.auth.uid in request.resource.data.members)
                    && !('pendingJoinToken' in request.resource.data);

      // Join via invite (non-member): adds self to members + sets pendingJoinToken.
      // Security rule validates the token via get() — no Cloud Function needed.
      allow update: if request.auth != null
                    && !isMember(listId)
                    && request.auth.uid in request.resource.data.members
                    && !(request.auth.uid in resource.data.members)
                    && 'pendingJoinToken' in request.resource.data
                    && validToken(request.resource.data.pendingJoinToken, listId);

      // Token cleanup (newly joined member removes the transient field).
      allow update: if request.auth != null && isMember(listId)
                    && !('pendingJoinToken' in request.resource.data)
                    && 'pendingJoinToken' in resource.data;

      // Household sub-collections (items, trips, markets, tripItems).
      match /{document=**} {
        allow read, write: if request.auth != null && isMember(listId);
      }
    }

    // ── Invite links (top-level, token = secret) ──────────────────────────────

    match /invites/{token} {
      // Any authenticated user can read (to validate a link before joining).
      allow read: if request.auth != null;

      // Only list members can create invites for their list.
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && isMember(request.resource.data.listId);

      // Only the creator can delete (consumed on join, or revoked by owner).
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;
    }

    // ── Per-user settings (defaultMarketId, listId pointer) ──────────────────

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── collectionGroup on tripItems (price history across trips) ─────────────
    // Replaces the old uid-based rule. isMember uses the denormalized listId
    // on each tripItem doc — the collectionGroup query also filters by listId.

    match /{path=**}/tripItems/{tripItemId} {
      allow read: if request.auth != null
                  && isMember(resource.data.listId);
    }
  }
}
