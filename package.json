{
  "name": "listajuan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --exclude \"**/*.emulator.test.ts\" --passWithNoTests",
    "test:emulator": "firebase emulators:exec --only auth,firestore \"vitest run src/lib/data --no-file-parallelism\"",
    "test:all": "vitest run --passWithNoTests",
    "e2e": "firebase emulators:exec --only auth,firestore \"playwright test\"",
    "e2e:headed": "firebase emulators:exec --only auth,firestore \"playwright test --headed\"",
    "build:emulator": "vite build --mode development",
    "dev:prod": "vite --mode production",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.12.3",
    "firebase-tools": "^15.19.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "firebase": "^12.14.0",
    "layerchart": "^1.0.13",
    "lucide-svelte": "^1.0.1",
    "svelte-spa-router": "^5.1.0"
  }
}
